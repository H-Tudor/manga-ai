# ─── MangaDex credentials ──────────────────────────────────────────────────
MANGADEX_CLIENT_ID=
MANGADEX_CLIENT_SECRET=

# ─── AI translation backend ────────────────────────────────────────────────
# Choose one: openai | anthropic | ollama  (default: openai)
AI_BACKEND=openai

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# Anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# Ollama (local — uncomment the ollama service in docker-compose.yml)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=minicpm-v

# ─── Storage (optional overrides for Docker) ──────────────────────────────
# MANGA_DB_URL=sqlite:////data/manga_cache.db
# MANGA_STORAGE_DIR=/data/translated
