{
  "realm": "manga-ai",
  "displayName": "Manga AI",
  "enabled": true,
  "sslRequired": "external",
  "registrationAllowed": true,
  "registrationEmailAsUsername": true,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "verifyEmail": false,
  "resetPasswordAllowed": true,
  "editUsernameAllowed": false,
  "bruteForceProtected": true,
  "permanentLockout": false,
  "maxFailureWaitSeconds": 900,
  "minimumQuickLoginWaitSeconds": 60,
  "waitIncrementSeconds": 60,
  "quickLoginCheckMilliSeconds": 1000,
  "maxDeltaTimeSeconds": 43200,
  "failureFactor": 5,
  "roles": {
    "realm": [
      {
        "name": "user",
        "description": "Standard manga-ai user",
        "composite": false,
        "clientRole": false,
        "containerId": "manga-ai"
      },
      {
        "name": "admin",
        "description": "Manga-ai administrator",
        "composite": false,
        "clientRole": false,
        "containerId": "manga-ai"
      }
    ]
  },
  "defaultRoles": ["user"],
  "clients": [
    {
      "clientId": "manga-ai-api",
      "name": "Manga AI API",
      "description": "Backend FastAPI service (confidential client, client-credentials)",
      "enabled": true,
      "clientAuthenticatorType": "client-secret",
      "secret": "change-me-in-production",
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "publicClient": false,
      "protocol": "openid-connect",
      "defaultClientScopes": ["web-origins", "roles", "profile", "email"]
    },
    {
      "clientId": "manga-ai-ui",
      "name": "Manga AI UI",
      "description": "Browser-based frontend (public PKCE client)",
      "enabled": true,
      "clientAuthenticatorType": "client-secret",
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "publicClient": true,
      "protocol": "openid-connect",
      "redirectUris": ["http://localhost/*", "http://localhost:80/*"],
      "webOrigins": ["http://localhost", "http://localhost:80"],
      "defaultClientScopes": ["web-origins", "roles", "profile", "email"],
      "attributes": {
        "pkce.code.challenge.method": "S256"
      }
    }
  ],
  "clientScopes": [
    {
      "name": "offline_access",
      "protocol": "openid-connect",
      "attributes": {
        "consent.screen.text": "Offline access"
      }
    }
  ],
  "browserSecurityHeaders": {
    "contentTypeOptions": "nosniff",
    "xRobotsTag": "none",
    "xFrameOptions": "SAMEORIGIN",
    "contentSecurityPolicy": "frame-src 'self'; frame-ancestors 'self'; object-src 'none';",
    "xContentTypeOptions": "nosniff",
    "xXSSProtection": "1; mode=block",
    "strictTransportSecurity": "max-age=31536000; includeSubDomains"
  },
  "smtpServer": {},
  "loginTheme": "",
  "accountTheme": "",
  "adminTheme": "",
  "emailTheme": "",
  "internationalizationEnabled": false,
  "supportedLocales": ["en"],
  "defaultLocale": "en",
  "accessTokenLifespan": 300,
  "ssoSessionIdleTimeout": 1800,
  "ssoSessionMaxLifespan": 36000,
  "offlineSessionIdleTimeout": 2592000,
  "accessCodeLifespan": 60,
  "accessCodeLifespanUserAction": 300
}
